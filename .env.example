# ============================================================
# FactCheck - Variáveis de Ambiente (versão Ollama - GRATUITO)
# Copia este ficheiro: cp .env.example .env
# ============================================================

# URL do servidor Ollama (por defeito corre em localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo LLM para extracção e classificação
# Opções recomendadas (por ordem de qualidade vs. velocidade):
#   llama3.2       — rápido, leve (2GB RAM) ← RECOMENDADO
#   mistral        — boa qualidade (4GB RAM)
#   llama3.1:8b    — melhor qualidade (5GB RAM)
LLM_MODEL=gemma4:31b-cloud

# Tamanho dos chunks de transcrição para análise (em segmentos)
CHUNK_SIZE=16

# Segmentos repetidos entre chunks adjacentes para preservar contexto sem reprocessar demais
CHUNK_OVERLAP=3

# Quantos chunks podem estar em processamento ao mesmo tempo
CHUNK_CONCURRENCY=2

# Pesquisa web paralela dentro de cada lote de claims
WEB_SEARCH_CONCURRENCY=4
SEARCH_VARIANTS=3
SEARCH_VARIANT_CONCURRENCY=2

# Quantos lotes de verificacao podem correr em paralelo
FACT_CHECK_CONCURRENCY=2

# Limites para evitar pedidos LLM presos durante minutos
LLM_TIMEOUT_SECONDS=45
CLAIM_EXTRACT_TIMEOUT_SECONDS=35
CLAIM_EXTRACT_NUM_PREDICT=800
FACT_CHECK_NUM_PREDICT=900
CLAIM_EXTRACT_RETRY_PARTS=4
CLAIM_EXTRACT_RETRY_WORDS=85
